{
    "name": "the-wireguard-effect",
    "version": "0.0.73",
    "description": "Cross platform wireguard api client for nodejs built on wireguard-go with effect-ts",
    "keywords": [
        "effect-ts",
        "vpn",
        "wireguard"
    ],
    "homepage": "https://github.com/leonitousconforti/the-wireguard-effect",
    "bugs": {
        "url": "https://github.com/leonitousconforti/the-wireguard-effect/issues",
        "email": "leo@leoconforti.us"
    },
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leonitousconforti/the-wireguard-effect.git"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null,
        "./*/index": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./*/index": null
        },
        "access": "public",
        "executableFiles": [
            "dist/linux-wg",
            "dist/darwin-wg",
            "dist/linux-wg-quick",
            "dist/darwin-wg-quick",
            "dist/linux-amd64-wireguard-go",
            "dist/linux-arm64-wireguard-go",
            "dist/darwin-amd64-wireguard-go",
            "dist/darwin-arm64-wireguard-go",
            "dist/win32-amd64-wireguard-go",
            "dist/win32-arm64-wireguard-go"
        ],
        "provenance": true
    },
    "scripts": {
        "build-submodules": "(cd submodules && ./build.bash)",
        "check": "tsc -b tsconfig.json",
        "clean": "rimraf .tsbuildinfo docs build dist coverage submodules/prebuilds && rimraf --glob src/*-wireguard-go src/*-wg-quick src/*-wintun.dll src/LICENSE-* src/*.exe src/*-bzImage src/*-wg src/wintun.dll",
        "codegen": "build-utils prepare-v4",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "build": "tsc -b tsconfig.build.json && pnpm babel && pnpm build-submodules",
        "circular": "madge --circular src/*.ts",
        "test": "vitest",
        "coverage": "vitest --coverage",
        "e2e-tests": "node ./e2e/run.mjs",
        "lint": "oxlint --disable-nested-config && oxfmt --check !repos/** !submodules/**",
        "lint-fix": "oxlint --disable-nested-config --fix && oxfmt --write !repos/** !submodules/**",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish",
        "prepare": "effect-tsgo patch --typescript --oxlint"
    },
    "dependencies": {
        "effect-schemas": "0.0.27",
        "ini": "^7.0.0"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@changesets/cli": "3.0.1",
        "@changesets/config": "4.0.0",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.0-rc.111",
        "@effect/platform-node": "4.0.0-rc.111",
        "@effect/tsgo": "0.36.1",
        "@effect/vitest": "4.0.0-rc.111",
        "@types/ini": "4.1.1",
        "@types/node": "25.9.5",
        "@vitest/coverage-v8": "4.1.11",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "effect": "4.0.0-rc.111",
        "es-main": "1.4.0",
        "fast-check": "4.9.0",
        "glob": "13.0.6",
        "madge": "8.0.0",
        "oxfmt": "0.62.0",
        "oxlint": "1.77.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.2.1",
        "rimraf": "6.1.3",
        "tsx": "4.23.11",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "peerDependencies": {
        "@effect/platform-node": "4.0.0-rc.111",
        "effect": "4.0.0-rc.111"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
